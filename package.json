{
  "name": "local-pdf-tools-mcp",
  "version": "0.1.0",
  "description": "Local stdio MCP server for PDF merge, split, page organize and images to PDF on your own machine. No network, no telemetry.",
  "keywords": [
    "mcp",
    "pdf",
    "merge-pdf",
    "split-pdf",
    "local",
    "offline",
    "privacy"
  ],
  "homepage": "https://noclaudkit.com/pdf/",
  "bugs": {
    "url": "https://github.com/swtormy-agents/local-pdf-tools-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swtormy-agents/local-pdf-tools-mcp.git"
  },
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "local-pdf-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "notices": "node scripts/notices.mjs",
    "fixtures": "node test/fixtures/generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "swtormy-agents",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@local-pdf-tools/core": "github:swtormy-agents/pdf-tools#047da26535530d1235f9d6df9bba946960a4cfee",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "pdf-lib": "1.17.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
